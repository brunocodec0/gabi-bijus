# ── Supabase ──────────────────────────────────────────────
# Copie este arquivo para .env.local e preencha com os valores
# do seu projeto (Dashboard do Supabase → Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# ── Loja ──────────────────────────────────────────────────
# Número do WhatsApp com DDI, só dígitos (ex.: 5521999999999).
# Fallback — o valor oficial é editado no painel (Conteúdo do site).
NEXT_PUBLIC_WHATSAPP_NUMBER=5521XXXXXXXXX

# URL pública do site em produção (sitemap, SEO, schema.org)
NEXT_PUBLIC_SITE_URL=https://gabibijus.vercel.app

# ── Frete (Melhor Envio) ─────────────────────────────────
# Token de integração da conta do Melhor Envio da lojista.
# Gerar em: melhorenvio.com.br → Painel → Integrações → Tokens.
# SECRETO: só no servidor — nunca com prefixo NEXT_PUBLIC_.
MELHOR_ENVIO_TOKEN=
